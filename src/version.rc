 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation"
            VALUE "FileDescription", "Service Configuration Utility"
            VALUE "FileVersion", "10.0.26200.1"
            VALUE "InternalName", "svcconfig"
            VALUE "LegalCopyright", "\251 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "svcconfig.exe"
            VALUE "ProductName", "Microsoft\256 Windows\256 Operating System"
            VALUE "ProductVersion", "10.0.26200.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
